PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/obsidian_capital
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Interactive Brokers
IBKR_CLIENT_ID=your_ibkr_oauth_client_id
IBKR_CLIENT_SECRET=your_ibkr_oauth_client_secret
IBKR_BASE_URL=https://api.ibkr.com/v1/api
IBKR_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/ibkr/callback

# Polygon.io (market data)
POLYGON_API_KEY=your_polygon_api_key
POLYGON_BASE_URL=https://api.polygon.io

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_MEMBER_PRICE_ID=price_member_monthly_id
STRIPE_PRIVATE_PRICE_ID=price_private_monthly_id

# Stripe Identity (KYC)
STRIPE_IDENTITY_VERIFICATION_WEBHOOK_SECRET=whsec_identity_webhook_secret

# AWS
AWS_ACCESS_KEY=your_aws_key
AWS_SECRET_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=obsidian-capital-assets

# Email/SMS
SENDGRID_KEY=your_sendgrid_key
TWILIO_KEY=your_twilio_key

# App URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

{
  "name": "obsidian-capital-backend",
  "version": "1.0.0",
  "description": "Obsidian Capital luxury stock brokerage backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
